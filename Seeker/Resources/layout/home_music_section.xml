<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="16dp">

    <LinearLayout
        android:id="@+id/home_sections"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/home_quick_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:clipToPadding="false"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <LinearLayout
            android:id="@+id/home_played_group"
            style="@style/MB.HomeSection">

            <TextView
                style="@style/MB.SectionTitle"
                android:text="@string/home_recently_played" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/home_played_list"
                style="@style/MB.HomeRow" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/home_albums_group"
            style="@style/MB.HomeSection">

            <TextView
                style="@style/MB.SectionTitle"
                android:text="@string/library_albums" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/home_albums_list"
                style="@style/MB.HomeRow" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/home_added_group"
            style="@style/MB.HomeSection">

            <TextView
                style="@style/MB.SectionTitle"
                android:text="@string/home_recently_added" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/home_added_list"
                style="@style/MB.HomeRow" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/home_playlists_group"
            style="@style/MB.HomeSection">

            <TextView
                style="@style/MB.SectionTitle"
                android:text="@string/library_playlists" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/home_playlists_list"
                style="@style/MB.HomeRow" />
        </LinearLayout>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/home_filtered_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/home_music_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="16dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:textColor="?attr/cellTextColorSubdued"
        android:textSize="15sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/home_signin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="16dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center"
        android:minHeight="48dp"
        android:text="@string/home_signin"
        android:textColor="?attr/mainPurple"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>
