<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/np_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="-12dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="-12dp">

        <ImageButton
            android:id="@+id/np_close"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentStart="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/player_close"
            android:src="@drawable/ic_keyboard_arrow_down_24"
            android:tint="?attr/cellTextColor" />

        <ImageButton
            android:id="@+id/np_sound"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/sound_title"
            android:src="@drawable/ic_equalizer_24"
            android:tint="?attr/cellTextColor" />
    </RelativeLayout>

    <FrameLayout
        android:id="@+id/np_art_holder"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/np_art"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_artwork"
            android:clipToOutline="true"
            android:contentDescription="@null" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/np_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="?attr/cellTextColor"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/np_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?attr/cellTextColorSubdued"
                android:textSize="16sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/np_add"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="-12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/playlist_add_to"
            android:src="@drawable/ic_playlist_add_24"
            android:tint="?attr/cellTextColor" />
    </LinearLayout>

    <SeekBar
        android:id="@+id/np_seek"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="-16dp"
        android:layout_marginEnd="-16dp"
        android:layout_marginTop="8dp"
        android:contentDescription="@string/player_seek"
        android:progressTint="?attr/mainPurple"
        android:thumbTint="?attr/mainPurple" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/np_elapsed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:textColor="?attr/cellTextColorSubdued"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/np_format"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:textColor="?attr/cellTextColorSubdued"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/np_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:textColor="?attr/cellTextColorSubdued"
            android:textSize="13sp" />
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/np_shuffle"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/player_shuffle"
            android:src="@drawable/ic_shuffle_24"
            android:tint="?attr/cellTextColorSubdued" />
        <ImageButton
            android:id="@+id/np_previous"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/player_previous"
            android:src="@drawable/ic_skip_previous_24"
            android:tint="?attr/cellTextColor" />
        <ImageButton
            android:id="@+id/np_play"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_play_button"
            android:contentDescription="@string/player_play"
            android:src="@drawable/ic_play_24"
            android:tint="?attr/colorOnPrimary" />
        <ImageButton
            android:id="@+id/np_next"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/player_next"
            android:src="@drawable/ic_skip_next_24"
            android:tint="?attr/cellTextColor" />
        <ImageButton
            android:id="@+id/np_repeat"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/player_repeat"
            android:src="@drawable/ic_repeat_24"
            android:tint="?attr/cellTextColorSubdued" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/np_output"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/np_output_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/np_output_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/np_queue"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="-12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/queue_title"
            android:src="@drawable/ic_queue_music_24"
            android:tint="?attr/cellTextColor" />
    </LinearLayout>
</LinearLayout>
</FrameLayout>
